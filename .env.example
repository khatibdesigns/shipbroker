# Firebase web config — copy to `.env` and fill in to enable cloud auth + sync.
# Without these the app runs fully on local (on-device) state.
# All EXPO_PUBLIC_* vars are bundled into the client (Firebase web keys are
# meant to be public; protect data with Firestore security rules instead).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Sign-In — iOS client + URL scheme from GoogleService-Info.plist
# (CLIENT_ID / REVERSED_CLIENT_ID); Web client ID from the Firebase Google provider.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ShipBroker AI agent — Claude-CLI proxy base URL on EC2 (the /ship endpoint).
EXPO_PUBLIC_SHIP_API_URL=http://16.16.79.251:8090

# Google Maps Platform key (Places API + Maps Static API). Optional — without it
# the wizard uses manual text entry + a placeholder map.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
