rules_version = '2';

// ShipBroker — each signed-in user (anonymous or otherwise) owns exactly one
// document at users/{uid} holding their profile (name, phone, persona, company,
// provider type). No cross-user access; nothing is readable while signed out.
//
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Future per-user subcollections (shipments, offers, RFQs) inherit ownership.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Shared catalog: top-rated carriers + available packages to carry.
    // Publicly readable; any signed-in user may seed it (first-run bootstrap).
    // TODO: before launch, restrict writes to an admin/service account.
    match /carriers/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /packages/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Marketplace: shipments are owned by their sender but readable by any
    // signed-in user, so carriers can discover open ones and bid.
    match /shipments/{sid} {
      function isOwner() {
        return request.auth != null && resource.data.senderId == request.auth.uid;
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isOwner();

      // Bids on a shipment. A carrier writes their own bid (carrierId == uid);
      // the shipment owner may also seed instant quotes and accept/decline bids.
      match /offers/{oid} {
        function shipmentOwner() {
          return request.auth != null
            && get(/databases/$(database)/documents/shipments/$(sid)).data.senderId == request.auth.uid;
        }
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && (request.resource.data.carrierId == request.auth.uid || shipmentOwner());
        allow update, delete: if request.auth != null
          && (resource.data.carrierId == request.auth.uid || shipmentOwner());
      }
    }
  }
}
